# name: test/sql/rds/rds_arn_attach.test
# description: test attaching an RDS instance discovered via DescribeDBInstances + IAM auth
# group: [rds]

require aws

require parquet

# The 'aws' secret type is registered by httpfs.
require httpfs

require postgres_scanner

require-env AWS_ACCESS_KEY_ID

require-env AWS_SECRET_ACCESS_KEY

set ignore_error_messages

statement ok
LOAD aws

statement ok
CREATE SECRET (
    TYPE s3,
    KEY_ID '{AWS_ACCESS_KEY_ID}',
    SECRET '{AWS_SECRET_ACCESS_KEY}',
    REGION 'eu-central-1'
);

statement ok
ATTACH 'arn:aws:rds:eu-central-1:840140254803:db:duckdb-connect-test' AS rds_db (
	USER 'user_2'
)

statement ok
select * from (show all tables) where database = 'rds_db';
